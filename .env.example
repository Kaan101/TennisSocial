# Copy to apps/api/.env and apps/web/.env.local. Never commit real secrets.

# --- API (apps/api/.env) ---
DATABASE_URL=postgresql://tennis:tennis@localhost:5432/tennisclub
PORT=43124
NODE_ENV=development
WEB_ORIGIN=http://localhost:43123
API_PUBLIC_URL=http://localhost:43124
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# SEED_DEMO is ignored when NODE_ENV=production. Demo users are never created in production.
SEED_DEMO=false
UPLOAD_DIR=./uploads
# Optional. When all three are set, uploads go to Cloudinary. Otherwise files stay on local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web (apps/web/.env.local) ---
API_INTERNAL_URL=http://127.0.0.1:43124

# --- Tests ---
# TEST_DATABASE_URL=postgresql://tennis:tennis@localhost:5432/tennisclub_test
