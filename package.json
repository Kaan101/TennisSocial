{
  "name": "kort",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @club/api --filter @club/web dev",
    "dev:api": "pnpm --filter @club/api dev",
    "dev:web": "pnpm --filter @club/web dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @club/api db:generate",
    "db:migrate": "pnpm --filter @club/api db:migrate",
    "db:deploy": "pnpm --filter @club/api db:deploy",
    "db:seed": "pnpm --filter @club/api db:seed"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "typescript-eslint": "8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
